    "#Calculate annual complaint volumes\n",
    "\n",
    "complaints = pd.read_excel(\n",
    "    complaints_path,\n",
    "    sheet_name=\"Data\"\n",
    ")\n",
    "\n",
    "annual_complaints = (\n",
    "    complaints.groupby(complaints['Date submitted'].dt.year)\n",
    "    .agg(\n",
    "        Total_Complaints=('Complaint ID', 'nunique')\n",
    "    )\n",
    "    .reset_index()\n",
    "    .rename(columns={'Date submitted': 'Year'})\n",
    ")\n",
    "\n",
    "display(annual_complaints)\n",
    "\n",
    "\n",
    "#Calculate year-on-year changes\n",
    "\n",
    "annual_complaints['Previous_Year'] = (\n",
    "    annual_complaints['Total_Complaints'].shift(1)\n",
    ")\n",
    "\n",
    "annual_complaints['YoY_Change'] = (\n",
    "    annual_complaints['Total_Complaints']\n",
    "    - annual_complaints['Previous_Year']\n",
    ")\n",
    "\n",
    "annual_complaints['YoY_Change_Percentage'] = (\n",
    "    annual_complaints['YoY_Change']\n",
    "    / annual_complaints['Previous_Year']\n",
    ") * 100\n",
    "\n",
    "display(annual_complaints.round(2))\n",
    "\n",
    "\n",
    "#Visualise annual complaint volumes\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "plt.bar(\n",
    "    annual_complaints['Year'].astype(str),\n",
    "    annual_complaints['Total_Complaints']\n",
    ")\n",
    "\n",
    "plt.title('Annual Consumer Complaint Volumes (2017–2023)')\n",
    "plt.xlabel('Year')\n",
    "plt.ylabel('Number of Complaints')\n",
    "plt.grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "#Analyse monthly complaint volumes\n",
    "monthly_complaints = (\n",
    "    complaints.groupby(\n",
    "        complaints['Date submitted'].dt.to_period('M')\n",
    "    )\n",
    "    .agg(\n",
    "        Total_Complaints=('Complaint ID', 'nunique')\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "monthly_complaints.columns = ['Year_Month', 'Total_Complaints']\n",
    "\n",
    "monthly_complaints['Month_Date'] = (\n",
    "    monthly_complaints['Year_Month'].dt.to_timestamp()\n",
    ")\n",
    "\n",
    "monthly_complaints['Three_Month_Average'] = (\n",
    "    monthly_complaints['Total_Complaints']\n",
    "    .rolling(window=3)\n",
    "    .mean()\n",
    ")\n",
    "\n",
    "display(monthly_complaints.head())\n",
    "\n",
    "\n",
    "#Visualise monthly trends\n",
    "plt.figure(figsize=(15, 6))\n",
    "\n",
    "plt.plot(\n",
    "    monthly_complaints['Month_Date'],\n",
    "    monthly_complaints['Total_Complaints'],\n",
    "    label='Monthly Complaints',\n",
    "    alpha=0.5\n",
    ")\n",
    "\n",
    "plt.plot(\n",
    "    monthly_complaints['Month_Date'],\n",
    "    monthly_complaints['Three_Month_Average'],\n",
    "    label='Three-Month Rolling Average',\n",
    "    linewidth=2\n",
    ")\n",
    "\n",
    "plt.title('Monthly Consumer Complaint Trends (2017–2023)')\n",
    "plt.xlabel('Month')\n",
    "plt.ylabel('Number of Complaints')\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "#Account for incomplete years\n",
    "\n",
    "annual_complaints['Months_Observed'] = (\n",
    "    complaints.groupby(\n",
    "        complaints['Date submitted'].dt.year\n",
    "    )['Date submitted'].nunique()\n",
    ")\n",
    "\n",
    "# Use distinct calendar months rather than distinct dates\n",
    "months_observed = (\n",
    "    complaints.groupby(\n",
    "        complaints['Date submitted'].dt.year\n",
    "    )['Date submitted']\n",
    "    .apply(lambda x: x.dt.to_period('M').nunique())\n",
    ")\n",
    "\n",
    "annual_complaints['Months_Observed'] = (\n",
    "    annual_complaints['Year'].map(months_observed)\n",
    ")\n",
    "\n",
    "annual_complaints['Average_Monthly_Complaints'] = (\n",
    "    annual_complaints['Total_Complaints']\n",
    "    / annual_complaints['Months_Observed']\n",
    ")\n",
    "\n",
    "display(\n",
    "    annual_complaints[\n",
    "        [\n",
    "            'Year',\n",
    "            'Total_Complaints',\n",
    "            'Months_Observed',\n",
    "            'Average_Monthly_Complaints',\n",
    "            'YoY_Change_Percentage'\n",
    "        ]\n",
    "    ].round(2)\n",
    ")\n",
    "\n",
    "\n",
    "#Visualise average monthly complaint volumes\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "plt.bar(\n",
    "    annual_complaints['Year'].astype(str),\n",
    "    annual_complaints['Average_Monthly_Complaints']\n",
    ")\n",
    "\n",
    "plt.title('Average Monthly Complaint Volume by Year')\n",
    "plt.xlabel('Year')\n",
    "plt.ylabel('Average Monthly Complaints')\n",
    "plt.grid(axis='y', alpha=0.3)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
