   "source": [
    "#Calculate complaints by product and issue\n",
    "product_issue_analysis = (\n",
    "    complaints.groupby(['Product', 'Issue'])\n",
    "    .agg(\n",
    "        Total_Complaints=('Complaint ID', 'nunique')\n",
    "    )\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "display(product_issue_analysis.head(10))\n",
    "\n",
    "\n",
    "#Calculate issue percentages within each product\n",
    "product_issue_analysis['Product_Total'] = (\n",
    "    product_issue_analysis\n",
    "    .groupby('Product')['Total_Complaints']\n",
    "    .transform('sum')\n",
    ")\n",
    "\n",
    "product_issue_analysis['Issue_Percentage'] = (\n",
    "    product_issue_analysis['Total_Complaints']\n",
    "    / product_issue_analysis['Product_Total']\n",
    ") * 100\n",
    "\n",
    "display(product_issue_analysis.round(2))\n",
    "\n",
    "\n",
    "#Identify the five most frequently reported issues within each product\n",
    "top_5_issues_by_product = (\n",
    "    product_issue_analysis\n",
    "    .sort_values(\n",
    "        ['Product', 'Total_Complaints'],\n",
    "        ascending=[True, False]\n",
    "    )\n",
    "    .groupby('Product')\n",
    "    .head(5)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "display(\n",
    "    top_5_issues_by_product[\n",
    "        [\n",
    "            'Product',\n",
    "            'Issue',\n",
    "            'Total_Complaints',\n",
    "            'Issue_Percentage'\n",
    "        ]\n",
    "    ].round(2)\n",
    ")\n",
    "\n",
    "\n",
    "#Identify the leading issue for each product\n",
    "leading_issue_by_product = (\n",
    "    product_issue_analysis\n",
    "    .sort_values(\n",
    "        ['Product', 'Total_Complaints'],\n",
    "        ascending=[True, False]\n",
    "    )\n",
    "    .groupby('Product')\n",
    "    .head(1)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "display(\n",
    "    leading_issue_by_product[\n",
    "        [\n",
    "            'Product',\n",
    "            'Issue',\n",
    "            'Total_Complaints',\n",
    "            'Issue_Percentage'\n",
    "        ]\n",
    "    ].round(2)\n",
    ")\n"
   ]
