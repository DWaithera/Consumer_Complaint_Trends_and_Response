    "\n",
    "#Check the calculated values\n",
    "forwarding_check = {\n",
    "    'Total Complaints': len(complaints),\n",
    "    'Missing Dates': complaints['Forwarding_Time_Days'].isna().sum(),\n",
    "    'Negative Intervals': (complaints['Forwarding_Time_Days'] < 0).sum(),\n",
    "    'Same-Day Forwarding': (complaints['Forwarding_Time_Days'] == 0).sum()\n",
    "}\n",
    "\n",
    "display(pd.Series(forwarding_check))\n",
    "\n",
    "#Calculate the forwarding-time distribution\n",
    "forwarding_summary = (\n",
    "    complaints['Forwarding_Time_Days']\n",
    "    .dropna()\n",
    "    .describe(percentiles=[0.25, 0.50, 0.75, 0.90, 0.95])\n",
    "    .to_frame(name='Forwarding_Time_Days')\n",
    ")\n",
    "\n",
    "display(forwarding_summary.round(2))\n",
    "\n",
    "#Calculate the percentage forwarded within specific timeframes\n",
    "valid_forwarding = complaints['Forwarding_Time_Days'].dropna()\n",
    "\n",
    "forwarding_performance = pd.DataFrame({\n",
    "    'Timeframe': [\n",
    "        'Same day',\n",
    "        'Within 1 day',\n",
    "        'Within 3 days',\n",
    "        'Within 5 days',\n",
    "        'Within 7 days'\n",
    "    ],\n",
    "    'Complaints': [\n",
    "        (valid_forwarding == 0).sum(),\n",
    "        (valid_forwarding <= 1).sum(),\n",
    "        (valid_forwarding <= 3).sum(),\n",
    "        (valid_forwarding <= 5).sum(),\n",
    "        (valid_forwarding <= 7).sum()\n",
    "    ]\n",
    "})\n",
    "\n",
    "forwarding_performance['Percentage'] = (\n",
    "    forwarding_performance['Complaints']\n",
    "    / len(valid_forwarding)\n",
    ") * 100\n",
    "\n",
    "display(forwarding_performance.round(2))"
   ]
  },
