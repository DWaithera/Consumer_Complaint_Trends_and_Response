    "#Annual complaint volumes\n",
    "complaints['Year'] = complaints['Date submitted'].dt.year\n",
    "\n",
    "annual_trends = (\n",
    "    complaints.groupby('Year')\n",
    "    .agg(Total_Complaints=('Complaint ID', 'nunique'))\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "display(annual_trends)\n",
    "\n",
    "#How reported issues changed over time\n",
    "yearly_issues = (\n",
    "    complaints.groupby(['Year', 'Issue'])\n",
    "    .agg(Total_Complaints=('Complaint ID', 'nunique'))\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "yearly_issues['Year_Total'] = (\n",
    "    yearly_issues.groupby('Year')['Total_Complaints'].transform('sum')\n",
    ")\n",
    "\n",
    "yearly_issues['Percentage'] = (\n",
    "    yearly_issues['Total_Complaints']\n",
    "    / yearly_issues['Year_Total']\n",
    ") * 100\n",
    "\n",
    "top_issues_by_year = (\n",
    "    yearly_issues\n",
    "    .sort_values(['Year', 'Total_Complaints'], ascending=[True, False])\n",
    "    .groupby('Year')\n",
    "    .head(5)\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "\n",
    "display(top_issues_by_year.round(2))\n",
    "\n",
    "#How company response categories changed over time\n",
    "yearly_responses = (\n",
    "    complaints.groupby(['Year', 'Company response to consumer'], dropna=False)\n",
    "    .agg(Total_Complaints=('Complaint ID', 'nunique'))\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "yearly_responses['Year_Total'] = (\n",
    "    yearly_responses.groupby('Year')['Total_Complaints'].transform('sum')\n",
    ")\n",
    "\n",
    "yearly_responses['Percentage'] = (\n",
    "    yearly_responses['Total_Complaints']\n",
    "    / yearly_responses['Year_Total']\n",
    ") * 100\n",
    "\n",
    "yearly_responses = yearly_responses.sort_values(\n",
    "    ['Year', 'Total_Complaints'],\n",
    "    ascending=[True, False]\n",
    ")\n",
    "\n",
    "display(yearly_responses.round(2))\n",
    "\n",
    "#How product complaint patterns changed over time\n",
    "yearly_products = (\n",
    "    complaints.groupby(['Year', 'Product'])\n",
    "    .agg(Total_Complaints=('Complaint ID', 'nunique'))\n",
    "    .reset_index()\n",
    ")\n",
    "\n",
    "yearly_products['Year_Total'] = (\n",
    "    yearly_products.groupby('Year')['Total_Complaints'].transform('sum')\n",
    ")\n",
    "\n",
    "yearly_products['Percentage'] = (\n",
    "    yearly_products['Total_Complaints']\n",
    "    / yearly_products['Year_Total']\n",
    ") * 100\n",
    "\n",
    "display(\n",
    "    yearly_products.sort_values(\n",
    "        ['Year', 'Total_Complaints'],\n",
    "        ascending=[True, False]\n",
    "    ).round(2)\n",
    ")"
